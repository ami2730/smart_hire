// SmartHire Backend — Prisma Schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  RECRUITER
  APPLICANT
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ResumeProcessingStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

enum ApplicationStatus {
  // Canonical application lifecycle
  SUBMITTED
  SCREENING
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN

  // Backwards compatibility aliases
  APPLIED
  PROCESSING
  SCREENED
  REVIEWED
}

enum ScreeningRecommendation {
  STRONG_MATCH
  GOOD_MATCH
  MODERATE_MATCH
  LOW_MATCH
}

// ==========================================
// MODELS
// ==========================================

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(RECRUITER)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  jobs         Job[]
  candidate    Candidate?
  auditLogs    AuditLog[]

  @@map("users")
}

model Job {
  id                     String          @id @default(uuid())
  recruiterId            String
  title                  String
  description            String          @db.Text
  responsibilities       String?         @db.Text
  location               String?
  employmentType         String?
  experienceRequirement  String?
  educationRequirement   String?         @db.Text
  status                 JobStatus       @default(DRAFT)
  minimumExperienceYears Float           @default(0)
  publishedAt            DateTime?
  deadline               DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  recruiter              User            @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  requirements           JobRequirement?
  jobSkills              JobSkill[]
  applications           Application[]

  @@index([recruiterId])
  @@index([status])
  @@index([publishedAt])
  @@map("jobs")
}

model JobRequirement {
  id                     String    @id @default(uuid())
  jobId                  String    @unique
  requiredSkills         String[]
  preferredSkills        String[]  @default([])
  educationRequirements String?   @db.Text
  minimumExperienceYears Float     @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  job                    Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_requirements")
}

model Candidate {
  id         String           @id @default(uuid())
  userId     String?          @unique
  name       String
  email      String           @unique
  phone      String?
  location   String?
  summary    String?          @db.Text
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  resumes      Resume[]
  skills       CandidateSkill[]
  education    Education[]
  experience   Experience[]
  applications Application[]

  @@index([userId])
  @@index([name])
  @@index([email])
  @@map("candidates")
}

model Resume {
  id               String                 @id @default(uuid())
  candidateId      String
  originalFileName String
  storedFileName   String
  filePath         String
  mimeType         String
  fileSize         Int
  extractedText    String?                @db.Text
  processingStatus ResumeProcessingStatus @default(UPLOADED)
  isDefault        Boolean                @default(false)
  uploadedAt       DateTime               @default(now())
  processedAt      DateTime?

  candidate        Candidate              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applications     Application[]

  @@index([candidateId])
  @@index([candidateId, isDefault])
  @@index([processingStatus])
  @@map("resumes")
}

model Skill {
  id              String           @id @default(uuid())
  name            String           @unique
  normalizedName  String?
  category        String?
  source          String?          @default("SYSTEM")
  createdAt       DateTime         @default(now())

  candidateSkills CandidateSkill[]
  jobSkills       JobSkill[]

  @@index([name])
  @@index([normalizedName])
  @@map("skills")
}

model JobSkill {
  id         String   @id @default(uuid())
  jobId      String
  skillId    String
  isRequired Boolean  @default(true)
  createdAt  DateTime @default(now())

  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@index([jobId])
  @@index([skillId])
  @@map("job_skills")
}

model CandidateSkill {
  id                String    @id @default(uuid())
  candidateId       String
  skillId           String
  yearsOfExperience Float?
  proficiencyLevel  String?
  createdAt         DateTime  @default(now())

  candidate         Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill             Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([candidateId, skillId])
  @@index([candidateId])
  @@index([skillId])
  @@map("candidate_skills")
}

model Education {
  id          String    @id @default(uuid())
  candidateId String
  institution String
  degree      String
  field       String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("education")
}

model Experience {
  id          String    @id @default(uuid())
  candidateId String
  company     String
  jobTitle    String
  description String?   @db.Text
  startDate   DateTime?
  endDate     DateTime?
  years       Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("experience")
}

model Application {
  id               String            @id @default(uuid())
  candidateId      String
  jobId            String
  resumeId         String?
  coverLetter      String?           @db.Text
  source           String            @default("REGISTERED")
  status           ApplicationStatus @default(SUBMITTED)
  appliedAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  candidate        Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job              Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume           Resume?           @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  screeningResults ScreeningResult[]

  @@unique([candidateId, jobId])
  @@index([jobId])
  @@index([candidateId])
  @@index([status])
  @@map("applications")
}

model ScreeningResult {
  id                      String                  @id @default(uuid())
  applicationId           String
  overallScore            Float
  skillMatchScore         Float
  experienceMatchScore    Float
  educationMatchScore     Float
  semanticSimilarityScore Float
  matchingSkills          String[]
  missingSkills           String[]
  recommendation          ScreeningRecommendation
  explanation             String?                 @db.Text
  evidence                Json?
  status                  String?
  modelVersion            String
  processedAt             DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  application             Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([overallScore])
  @@index([recommendation])
  @@map("screening_results")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  timestamp  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@map("audit_logs")
}
