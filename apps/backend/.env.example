NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smarthire
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_replace_in_production_32chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_replace_in_production_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ML_SERVICE_URL=http://localhost:8000
ML_REQUEST_TIMEOUT_MS=30000
UPLOAD_DIR=./uploads
MAX_RESUME_SIZE_MB=10
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
